# ─────────────────────────────────────────────────────────────────────────────
# STWV Management Platform — environment variables
# Copy this file to `.env` and fill in real values for local development.
# `.env` is git-ignored. Never commit real secrets.
# ─────────────────────────────────────────────────────────────────────────────

# PostgreSQL connection string used by Drizzle ORM and the API server.
# Provisioned automatically on Replit; for a local Postgres use e.g.
# postgresql://postgres:postgres@localhost:5432/stwv
DATABASE_URL=

# Clerk publishable key (frontend). Find it in the Clerk Dashboard → API Keys.
# Use the dev key locally — Replit auto-swaps to the live key on deploy.
VITE_CLERK_PUBLISHABLE_KEY=

# Clerk secret key (backend). Required by @clerk/express to verify JWTs.
CLERK_SECRET_KEY=

# Optional: bootstrap a default admin user on `pnpm db:seed`.
# Set both to seed an admin user record linked to a real Clerk account.
PLATFORM_ADMIN_CLERK_ID=
PLATFORM_ADMIN_EMAIL=

# Optional: comma-separated allow-list of email addresses that get auto-
# promoted to `admin` on first sign-in via GET /api/users/me.
# Useful when you don't yet know the Clerk user id.
PLATFORM_ADMIN_EMAILS=

# Optional: Resend API key for outbound email (notifications, weekly summary).
# If unset, the API server logs emails instead of sending them.
RESEND_API_KEY=

# Port the API server binds to. On Replit this is set automatically per
# artifact; locally default to 8080.
PORT=8080

# Node env. Leave unset locally; deployment sets it to "production".
# NODE_ENV=development
